<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.linguaplus.controlador.MatriculasControlador"
      spacing="20">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <ScrollPane fitToWidth="true" prefWidth="340" minWidth="320" styleClass="scroll-transparente">
        <VBox styleClass="tarjeta">
            <Label text="Nueva matricula" styleClass="tarjeta-titulo"/>
            <Label text="Periodo" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbPeriodo" maxWidth="Infinity"/>
            <Label text="Estudiante *" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbEstudiante" promptText="Seleccione" maxWidth="Infinity"/>
            <Label text="Programa *" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbPrograma" promptText="Seleccione" maxWidth="Infinity"/>
            <Label text="Fecha de inicio *" styleClass="etiqueta"/>
            <DatePicker fx:id="dpFechaInicio" maxWidth="Infinity"/>
            <Label text="Tutor (solo programas personalizados)" styleClass="etiqueta"/>
            <HBox spacing="6">
                <ComboBox fx:id="cmbTutor" promptText="Sin tutor" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Quitar" onAction="#quitarTutor"/>
            </HBox>
            <Label text="Servicios adicionales (Ctrl + clic)" styleClass="etiqueta"/>
            <ListView fx:id="lstServicios" prefHeight="85"/>
            <Label text="Descuento % (maximo 30)" styleClass="etiqueta"/>
            <TextField fx:id="txtDescuento" promptText="0"/>
            <Label text="Observaciones" styleClass="etiqueta"/>
            <TextArea fx:id="txtObservaciones" prefRowCount="2" wrapText="true"/>
            <Button text="Registrar matricula" styleClass="boton-primario"
                    maxWidth="Infinity" onAction="#registrarMatricula"/>
            <Label fx:id="lblMensaje" wrapText="true"/>
        </VBox>
    </ScrollPane>

    <VBox spacing="20" HBox.hgrow="ALWAYS">
        <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
            <Label text="Matriculas registradas" styleClass="tarjeta-titulo"/>
            <TableView fx:id="tblMatriculas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNumero" text="N°" prefWidth="50"/>
                    <TableColumn fx:id="colEstudiante" text="Estudiante" prefWidth="140"/>
                    <TableColumn fx:id="colPrograma" text="Programa" prefWidth="150"/>
                    <TableColumn fx:id="colInicio" text="Inicio" prefWidth="90"/>
                    <TableColumn fx:id="colTutor" text="Tutor" prefWidth="110"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="100"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
        <HBox spacing="20" prefHeight="270">
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Comprobante de pago" styleClass="tarjeta-titulo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="cmbFormato"/>
                </HBox>
                <TextArea fx:id="txtComprobante" editable="false" styleClass="comprobante" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox styleClass="tarjeta" prefWidth="280">
                <Label text="Kit de bienvenida" styleClass="tarjeta-titulo"/>
                <Label fx:id="lblKit" wrapText="true" styleClass="kit"/>
            </VBox>
        </HBox>
    </VBox>
</HBox>